# ESP32-S31 specific defaults
CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# USB Serial/JTAG secondary console
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# USB-OTG TinyUSB CDC virtual serial console (required by ESP-Mosaico USB-C port)
CONFIG_TINYUSB_CDC_ENABLED=y

# PSRAM for Pre-roll, Opus queues, Voiceprint Tensor Arena, JPEG/LCD buffers
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y

# C++20 / mDNS / WebSocket / AFE assembly stack headroom in app_main
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_MDNS_TASK_STACK_SIZE=8192
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y

# Keep internal DRAM free for Wi-Fi/lwIP DMA, PSA hardware crypto, and task stacks
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Trim Wi-Fi static DMA buffers & IRAM placement (ESP32-S31 uses unified DIRAM)
# so >70 KB internal DRAM stays free for WSS task stack and PSA SHA DMA contexts
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# Chinese MultiNet7 model for custom wake phrase ("ni hao xiao yuan")
CONFIG_SR_MN_CN_MULTINET7_QUANT=y

# Allocate mbedTLS TLS record/handshake buffers and mDNS heap in PSRAM so
# internal DMA-capable DRAM remains available for PSA hardware SHA/AES contexts
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
